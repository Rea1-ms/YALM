<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>annotations</Nullable>
    <UseWindowsForms>True</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPublishable>True</IsPublishable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>YALM.Mechrevo.MechrevoProgram</StartupObject>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <AssemblyName>YALM</AssemblyName>
    <RootNamespace>GHelper</RootNamespace>
    <Product>YALM</Product>
    <AssemblyTitle>YALM</AssemblyTitle>
    <Description>机械革命性能模式与风扇状态工具，基于 G-Helper。</Description>
    <PlatformTarget>x64</PlatformTarget>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <DebugType>embedded</DebugType>
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\x64\$(Configuration)\</IntermediateOutputPath>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <Version>0.1.0</Version>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="logs\**" />
    <EmbeddedResource Remove="logs\**" />
    <None Remove="logs\**" />
  </ItemGroup>

  <!-- The product is now Mechrevo-only. Keep the archived upstream ASUS
       implementation out of the active assembly while retaining the source
       snapshot in .cache/asus_backup for reference. -->
  <ItemGroup>
    <Compile Remove="Program.cs;Asus*.cs;Extra*.cs;Fans*.cs;Handheld*.cs;HardwareControl.cs;Matrix*.cs;NativeMethods.cs;Settings*.cs;Slash*.cs;Updates*.cs" />
    <EmbeddedResource Remove="Asus*.resx;Extra*.resx;Fans*.resx;Handheld*.resx;Matrix*.resx;Settings*.resx;Slash*.resx;Updates*.resx" />
    <Compile Remove="Ally\**;AnimeMatrix\**;AutoUpdate\**;Battery\**;Fan\**;Gpu\**;Input\**;Mode\**;Pawn\**;Peripherals\**;USB\**" />
    <Compile Remove="Display\**;Helpers\**" />
    <Compile Include="Display\DisplayNative.cs" />
    <Compile Include="Helpers\Drawing.cs;Helpers\Logger.cs;Helpers\MemoryHelper.cs;Helpers\OSDBase.cs;Helpers\ProcessHelper.cs" />
  </ItemGroup>


  <ItemGroup>
    <Content Include="favicon.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FftSharp" Version="2.2.0" />
    <PackageReference Include="HidSharpCore" Version="1.3.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.4.0" />
    <PackageReference Include="NvAPIWrapper.Net" Version="0.8.1.101" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="TaskScheduler" Version="2.12.2" />
    <PackageReference Include="WinForms.DataVisualization" Version="1.10.2" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Pawn\RyzenSMU.bin">
      <LogicalName>GHelper.RyzenSMU.bin</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Pawn\IntelMSR.bin">
      <LogicalName>GHelper.IntelMSR.bin</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 构建、发布不停止任何正在运行的控制台，也不调用外部脚本。 -->
</Project>
